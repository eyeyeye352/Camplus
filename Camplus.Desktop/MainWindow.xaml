<Window x:Class="Camplus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Camplus" Height="768" Width="1024"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <ToolBar Grid.Row="0" Height="35" Background="#2c3e50">
            <Button x:Name="RefreshBtn" Click="RefreshBtn_Click" ToolTip="刷新" Width="50" Height="28" Background="Transparent" Foreground="White" BorderBrush="Transparent" BorderThickness="0">
                <TextBlock Text="刷新"/>
            </Button>
            <Separator Width="10"/>
            <Button x:Name="DevToolsBtn" Click="DevToolsBtn_Click" ToolTip="开发者工具" Width="80" Height="28" Background="Transparent" Foreground="White" BorderBrush="Transparent" BorderThickness="0">
                <TextBlock Text="开发者工具"/>
            </Button>
            <Separator Width="10"/>
            <TextBlock x:Name="StatusText" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"/>
            <TextBlock Text=" | " Foreground="#666" Margin="10,0,0,0"/>
            <TextBlock x:Name="UrlText" Foreground="#aaa" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Width="400" TextTrimming="CharacterEllipsis"/>
        </ToolBar>
        
        <wv2:WebView2 x:Name="WebView" Grid.Row="1"/>
    </Grid>
</Window>