<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- 项目代码：INFO 级别，保留运行信息 -->
    <logger name="com.camplus" level="INFO"/>
    <!-- Spring 框架：仅警告和错误 -->
    <logger name="org.springframework" level="WARN"/>
    <!-- 数据库连接池：仅警告和错误 -->
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <!-- MyBatis：仅警告和错误，屏蔽 SQL 调试日志 -->
    <logger name="org.mybatis" level="WARN"/>

    <!-- import-only 模式：更精简 -->
    <springProfile name="import-only">
        <root level="WARN"/>
        <logger name="com.camplus" level="INFO"/>
        <logger name="com.camplus.admin.service.DataImportService" level="INFO"/>
        <logger name="com.camplus.admin.runner.DataImportRunner" level="INFO"/>
        <logger name="com.camplus.admin.service.impl.KnowledgeExtractServiceImpl" level="INFO"/>
        <logger name="com.camplus.vector.service.BgeM3OnnxService" level="INFO"/>
    </springProfile>
</configuration>
